<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>E-virtual | Fin de Año</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #0f172a;
      color: white;
      text-align: center;
      padding: 40px 20px;
    }
    h1 {
      font-size: 26px;
      margin-bottom: 10px;
    }
    p {
      opacity: 0.9;
    }
    input {
      display: none;
    }
    button {
      background: #2563eb;
      color: white;
      border: none;
      padding: 18px 28px;
      font-size: 18px;
      border-radius: 10px;
      margin-top: 25px;
    }
    button:disabled {
      background: gray;
    }
    #status {
      margin-top: 20px;
    }
  </style>
</head>
<body>

  <h1>E-virtual</h1>
  <p>Sacá tu foto del evento</p>

  <input
    type="file"
    id="camera"
    accept="image/*"
    capture="environment"
  />

  <button onclick="takePhoto()">📸 Tomar foto</button>

  <div id="status"></div>

<script>
const SCRIPT_URL = "PEGAR_ACÁ_TU_WEB_APP_URL";

function takePhoto() {
  document.getElementById("camera").click();
}

document.getElementById("camera").addEventListener("change", function () {
  const file = this.files[0];
  if (!file) return;

  document.getElementById("status").innerText = "Subiendo foto...";
  document.querySelector("button").disabled = true;

  const reader = new FileReader();
  reader.onloadend = function () {
    fetch(SCRIPT_URL, {
      method: "POST",
      body: new URLSearchParams({
        image: reader.result.split(",")[1]
      })
    })
    .then(() => {
      document.getElementById("status").innerText =
        "Gracias por ser parte del cierre de año";
    })
    .catch(() => {
      document.getElementById("status").innerText =
        "Error al subir la foto";
      document.querySelector("button").disabled = false;
    });
  };

  reader.readAsDataURL(file);
});
</script>

</body>
</html>